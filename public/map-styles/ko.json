{
  "version": 8,
  "name": "LocalMap White Theme",
  "metadata": {},
  "sources": {
    "protomaps": {
      "type": "vector",
      "url": "pmtiles://https://example.com/kr.pmtiles",
      "attribution": "Map data © OpenStreetMap contributors, Protomaps"
    }
  },
  "sprite": "",
  "glyphs": "https://protomaps.github.io/basemaps-assets/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f8f9fa"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "water",
      "paint": {
        "fill-color": "#e0f2fe"
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "paint": {
        "line-color": "#e5e7eb",
        "line-width": 1.5
      }
    },
    {
      "id": "boundaries",
      "type": "line",
      "source": "protomaps",
      "source-layer": "boundaries",
      "paint": {
        "line-color": "#cbd5e1",
        "line-width": 1,
        "line-dasharray": [2, 2]
      }
    },
    {
      "id": "places",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "places",
      "layout": {
        "text-field": ["get", "name:ko"],
        "text-font": ["Noto Sans Regular"],
        "text-size": 12
      },
      "paint": {
        "text-color": "#64748b",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      }
    }
  ]
}
