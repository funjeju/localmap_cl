{
  "version": 8,
  "name": "Korea Map Style",
  "metadata": {
    "mapbox:autocomposite": true,
    "mapbox:type": "template",
    "openmaptiles:mapbox_z_order": "auto"
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "pmtiles:///protomaps.pmtiles"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f0ede5"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#d0d4ff"
      }
    },
    {
      "id": "landcover_grass",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": [
        "==",
        "class",
        "grass"
      ],
      "paint": {
        "fill-color": "#d3e3b0",
        "fill-opacity": 0.5
      }
    },
    {
      "id": "landcover_wood",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": [
        "==",
        "class",
        "wood"
      ],
      "paint": {
        "fill-color": "#6d8f3e",
        "fill-opacity": 0.5
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "paint": {
        "fill-color": "#d4ccc8",
        "fill-opacity": 0.6
      }
    },
    {
      "id": "building-outline",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "building",
      "paint": {
        "line-color": "#c0bbb7",
        "line-width": 0.5
      }
    },
    {
      "id": "road-secondary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "==",
        "class",
        "secondary"
      ],
      "paint": {
        "line-color": "#f4f0e8",
        "line-width": 1.5
      }
    },
    {
      "id": "road-primary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "==",
        "class",
        "primary"
      ],
      "paint": {
        "line-color": "#f9f3ed",
        "line-width": 2
      }
    },
    {
      "id": "road-trunk",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "==",
        "class",
        "trunk"
      ],
      "paint": {
        "line-color": "#f4b6a1",
        "line-width": 2.5
      }
    },
    {
      "id": "poi-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "minzoom": 14,
      "layout": {
        "text-field": [
          "get",
          "name:ko"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 10,
        "text-offset": [
          0,
          0.6
        ],
        "text-anchor": "top"
      },
      "paint": {
        "text-color": "#4a4a4a",
        "text-halo-color": "#ffffff",
        "text-halo-width": 0.8
      }
    }
  ]
}
